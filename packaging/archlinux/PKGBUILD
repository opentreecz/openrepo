# Maintainer: opentree.cz <info@opentree.cz>
pkgname=openrepo
pkgver=0.0.0
pkgrel=1
pkgdesc="Web-based package repository management server for deb, rpm, and generic packages"
arch=('any' 'x86_64' 'aarch64' 'armv7h' 'i686')
url="https://github.com/opentreecz/openrepo"
license=('AGPL-3.0-only')
depends=(
    'python>=3.10'
    'python-pip'
    'python-virtualenv'
    'nginx'
    'postgresql'
    'gnupg'
    'nodejs>=20'
    'npm'
)
makedepends=(
    'python-setuptools'
    'nodejs'
    'npm'
)
optdepends=(
    'createrepo_c: Required for RPM repository support'
    'python-apt: Required for DEB repository support'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/opentreecz/openrepo/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')
backup=('etc/openrepo/openrepo.env')

build() {
    cd "$srcdir/$pkgname-$pkgver"

    # Build frontend
    cd frontend
    npm ci
    npm run build
    cd ..

    # Create virtualenv with dependencies
    python -m venv "$srcdir/venv"
    "$srcdir/venv/bin/pip" install --no-cache-dir -r web/requirements.txt
}

package() {
    cd "$srcdir/$pkgname-$pkgver"

    # Install application
    install -d "$pkgdir/opt/openrepo"
    cp -r web/* "$pkgdir/opt/openrepo/"
    cp -r frontend/dist "$pkgdir/opt/openrepo/frontend-dist"

    # Install virtualenv
    cp -r "$srcdir/venv" "$pkgdir/opt/openrepo/venv"

    # Fix virtualenv paths (relocate)
    sed -i "s|$srcdir/venv|/opt/openrepo/venv|g" \
        "$pkgdir/opt/openrepo/venv/bin/"* 2>/dev/null || true

    # Install systemd service files
    install -Dm644 packaging/systemd/openrepo-web.service \
        "$pkgdir/usr/lib/systemd/system/openrepo-web.service"
    install -Dm644 packaging/systemd/openrepo-worker.service \
        "$pkgdir/usr/lib/systemd/system/openrepo-worker.service"

    # Install nginx config
    install -Dm644 deploy/nginx/nginx.conf.prod \
        "$pkgdir/etc/nginx/sites-available/openrepo"

    # Install default config
    install -Dm640 .env.example "$pkgdir/etc/openrepo/openrepo.env"

    # Create data directories
    install -d "$pkgdir/var/lib/openrepo/storage"
    install -d "$pkgdir/var/lib/openrepo/repos"
    install -d "$pkgdir/var/lib/openrepo/keyring"
}
