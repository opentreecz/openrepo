# =============================================================================
# OpenRepo — Environment Configuration
# =============================================================================
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env && $EDITOR .env
#
# docker compose reads .env automatically. NEVER commit .env to version control.
# docker-compose.yml declares every variable below as ${VAR:-default} in a
# shared environment block used by the django, worker and beat services, so
# each one has a working default and any value set here overrides it.
# Commented-out lines show the default that applies when left unset.
# For a native deployment, export these variables before starting the app.
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED — Django secret key
# ---------------------------------------------------------------------------
# Used for session signing, CSRF tokens, password hashing, and field encryption.
# The server will refuse to start without this.
#
# Generate with:
#   python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
#   openssl rand -hex 64
#
# OPENREPO_SECRET_KEY is preferred; DJANGO_SECRET_KEY is accepted for
# upstream compatibility.
OPENREPO_SECRET_KEY=
# Legacy fallback; leave unset when OPENREPO_SECRET_KEY is configured.
# DJANGO_SECRET_KEY=

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Password for the PostgreSQL database. Change this for production.
OPENREPO_PG_PASSWORD=changeme

# Database name (default: openrepo)
# OPENREPO_PG_DATABASE=openrepo

# Database user (default: postgres)
# OPENREPO_PG_USERNAME=postgres

# Database backend: sqlite (native default) or postgresql (Compose default).
# Point PG_HOSTNAME/PG_PORT at an external server to skip the bundled db.
# OPENREPO_DB_TYPE=postgresql
# OPENREPO_PG_HOSTNAME=db
# OPENREPO_PG_PORT=5432

# Persistent database connection lifetime in seconds (0 disables persistence).
# OPENREPO_PG_CONN_MAX_AGE=300

# ---------------------------------------------------------------------------
# Celery / Redis — required for asynchronous uploads and repository builds
# ---------------------------------------------------------------------------
# Used for both the Celery broker and result backend by django, worker and
# beat. Must point at a reachable Redis (the bundled "redis" service by default).
# If the broker is unreachable, the web process processes uploads in-process
# instead of returning HTTP 500, but repository rebuilds still need the worker.
# OPENREPO_REDIS_URL=redis://redis:6379/0

# Number of concurrent Celery worker processes (worker service).
# OPENREPO_WORKER_CONCURRENCY=4

# `manage.py runworker` embeds Celery Beat by default. Set to 0 when a separate
# beat process/service is running (the supplied Compose file uses the worker
# and beat services directly and does not need this).
# OPENREPO_WORKER_BEAT=1

# Seconds the web process waits for the broker before falling back, and how
# many times it retries publishing a task.
# OPENREPO_BROKER_CONNECTION_TIMEOUT=5
# OPENREPO_BROKER_PUBLISH_RETRIES=2

# Only one rebuild per repository runs at a time (file lock under
# OPENREPO_VAR_DIR/locks). A queued rebuild suppresses further dispatches for
# this many seconds, so the queue never fills with duplicate rebuilds.
# OPENREPO_REBUILD_QUEUED_TTL=300

# Seconds between safety-net scans for stale repositories (package changes
# already enqueue a rebuild immediately).
# OPENREPO_STALE_CHECK_INTERVAL=60

# Set to 1 to log every periodic check_stale_repos run (3 INFO lines per run).
# OPENREPO_LOG_PERIODIC_TASKS=0

# Seconds a repository DELETE waits for a running rebuild of that repo before
# answering 409 REPO_BUSY.
# OPENREPO_REPO_DELETE_LOCK_TIMEOUT=120

# Development/test only: execute tasks synchronously instead of using workers.
# Keep disabled in production; this is not a fix for an unavailable broker.
# OPENREPO_CELERY_EAGER=0

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
# Host port for the web UI (maps to nginx container port 8080)
# OPENREPO_PORT=7376

# Container images (pin a release tag for reproducible deployments)
# OPENREPO_IMAGE=ghcr.io/opentreecz/openrepo:latest
# OPENREPO_REDIS_IMAGE=redis:7-alpine
# OPENREPO_POSTGRES_IMAGE=postgres:16-alpine

# Domain name shown in repo instructions and used for ALLOWED_HOSTS
# (default: localhost:8080)
# OPENREPO_DOMAIN=repo.example.com

# Additional allowed hosts (comma-separated)
# OPENREPO_ALLOWED_HOSTS=repo-internal.local,10.0.0.5

# Trusted origins for CSRF protection behind a reverse proxy (space-delimited)
# OPENREPO_CSRF_TRUSTED_ORIGINS=https://repo.example.com

# ---------------------------------------------------------------------------
# Application settings
# ---------------------------------------------------------------------------
# Enable Django debug mode (never use in production)
# OPENREPO_DEBUG=FALSE

# Maximum upload file size in bytes (default: 2 GB = 2147483648)
# OPENREPO_MAX_UPLOAD_SIZE=2147483648

# Log level for the openrepo_web logger (DEBUG, INFO, WARNING, ERROR)
# OPENREPO_LOGLEVEL=INFO

# Base directory for persistent application data (native default shown).
# Docker mounts its shared data volume at /var/lib/openrepo.
# OPENREPO_VAR_DIR=/var/lib/openrepo/

# Set to 1 to disable API throttling (development/tests only).
# OPENREPO_DISABLE_THROTTLE=0

# Set to 1 to use pure-Python Debian/RPM repository tooling fallbacks.
# OPENREPO_USE_PYTHON_TOOLS=0

# Seconds before apt-ftparchive/createrepo_c/gpg is killed during a repo build.
# Must cover a cold (uncached) build of your largest repo.
# OPENREPO_SUBPROCESS_TIMEOUT=3600

# Ignore RPM build number in version comparison
# RPM_VERSION_IGNORE_BUILD_NUM=false

# ---------------------------------------------------------------------------
# Python CLI (cli/main.py) — export in the shell running the CLI
# ---------------------------------------------------------------------------
# These are separate from the openrepo-sync Rust client's variables.
# OPENREPO_SERVER=http://localhost:7376
# OPENREPO_APIKEY=
