# =============================================================================
# OpenRepo — Environment Configuration
# =============================================================================
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env && $EDITOR .env
#
# docker compose reads .env automatically. NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED — Django secret key
# ---------------------------------------------------------------------------
# Used for session signing, CSRF tokens, password hashing, and field encryption.
# The server will refuse to start without this.
#
# Generate with:
#   python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
#   openssl rand -hex 64
#
# OPENREPO_SECRET_KEY is preferred; DJANGO_SECRET_KEY is accepted for
# upstream compatibility.
OPENREPO_SECRET_KEY=

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Password for the PostgreSQL database. Change this for production.
OPENREPO_PG_PASSWORD=changeme

# Database name (default: openrepo)
# OPENREPO_PG_DATABASE=openrepo

# Database user (default: postgres)
# OPENREPO_PG_USERNAME=postgres

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
# Host port for the web UI (maps to nginx container port 8080)
# OPENREPO_PORT=7376

# Domain name shown in repo instructions and used for ALLOWED_HOSTS
# OPENREPO_DOMAIN=repo.example.com

# Additional allowed hosts (comma-separated)
# OPENREPO_ALLOWED_HOSTS=repo-internal.local,10.0.0.5

# Trusted origins for CSRF protection behind a reverse proxy (space-delimited)
# OPENREPO_CSRF_TRUSTED_ORIGINS=https://repo.example.com

# ---------------------------------------------------------------------------
# Application settings
# ---------------------------------------------------------------------------
# Enable Django debug mode (never use in production)
# OPENREPO_DEBUG=FALSE

# Maximum upload file size in bytes (default: 2 GB = 2147483648)
# OPENREPO_MAX_UPLOAD_SIZE=2147483648

# Log level for the openrepo_web logger (DEBUG, INFO, WARNING, ERROR)
# OPENREPO_LOGLEVEL=INFO

# Ignore RPM build number in version comparison
# RPM_VERSION_IGNORE_BUILD_NUM=false
