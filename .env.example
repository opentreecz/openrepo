# OpenRepo environment configuration
# Copy this file to .env and fill in your values.

# Django secret key — used for session signing, CSRF tokens, etc.
# REQUIRED — the server will not start without this.
# Generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
# Or: openssl rand -hex 64
# OPENREPO_SECRET_KEY is preferred; DJANGO_SECRET_KEY is accepted for upstream compatibility.
OPENREPO_SECRET_KEY=

# PostgreSQL password for the OpenRepo database.
# If not set, the default "postgres" is used (change this for production).
OPENREPO_PG_PASSWORD=
